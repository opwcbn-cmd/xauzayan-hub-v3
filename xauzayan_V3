local function clrESP()
    for _,p in pairs(Players:GetPlayers()) do
        if p.Character then
            local h = p.Character:FindFirstChild("ESPH") if h then h:Destroy() end
            local hd2 = p.Character:FindFirstChild("Head")
            if hd2 then local bb = hd2:FindFirstChild("ESPBB") if bb then bb:Destroy() end end
        end
    end
end

-- FITUR FLY
local function startFly()
    local c = LP.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hm = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hm then return end
    
    local o1 = hrp:FindFirstChild("FlyBV") if o1 then o1:Destroy() end
    local o2 = hrp:FindFirstChild("FlyBG") if o2 then o2:Destroy() end
    
    local bv = Instance.new("BodyVelocity", hrp) bv.Name = "FlyBV" bv.MaxForce = Vector3.new(9e9,9e9,9e9) bv.Velocity = Vector3.zero
    local bg = Instance.new("BodyGyro", hrp) bg.Name = "FlyBG" bg.MaxTorque = Vector3.new(9e9,9e9,9e9) bg.P = 3000 bg.D = 100
    hm.PlatformStand = true
    
    if flyC then flyC:Disconnect() end
    flyC = RunService.RenderStepped:Connect(function()
        if not flyOn or not hrp or not hrp.Parent then return end
        local s = FLY_S
        local cam = workspace.CurrentCamera
        if not cam then return end
        local mv = hm.MoveDirection
        local d = Vector3.zero
        local mo = false
        if mv.Magnitude > 0.05 then
            mo = true
            local lk = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
            local rt = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
            if lk.Magnitude > 0.001 then lk = lk.Unit end
            if rt.Magnitude > 0.001 then rt = rt.Unit end
            d = lk * -mv.Z + rt * mv.X
            if d.Magnitude > 0.001 then d = d.Unit end
        end
        bv.Velocity = d * s + Vector3.new(0, upDown * s, 0)
        if mo then bg.CFrame = CFrame.new(hrp.Position, hrp.Position + d) end
    end)
    
    if tS1 then tS1:Disconnect() end
    if tM1 then tM1:Disconnect() end
    if tE1 then tE1:Disconnect() end
    tS1 = UIS.TouchStarted:Connect(function(i) if not flyOn then return end tStartY = i.Position.Y end)
    tM1 = UIS.TouchMoved:Connect(function(i)
        if not flyOn or not tStartY then return end
        local dd = i.Position.Y - tStartY
        if dd < -40 then upDown = 1 elseif dd > 40 then upDown = -1 else upDown = 0 end
    end)
    tE1 = UIS.TouchEnded:Connect(function() tStartY = nil upDown = 0 end)
end

local function stopFly()
    if flyC then flyC:Disconnect() flyC = nil end
    if tS1 then tS1:Disconnect() tS1 = nil end
    if tM1 then tM1:Disconnect() tM1 = nil end
    if tE1 then tE1:Disconnect() tE1 = nil end
    upDown = 0 tStartY = nil
    local c = LP.Character
    if c then
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local hm = c:FindFirstChildOfClass("Humanoid")
        if hrp then
            local bv = hrp:FindFirstChild("FlyBV") if bv then bv:Destroy() end
            local bg = hrp:FindFirstChild("FlyBG") if bg then bg:Destroy() end
        end
        if hm then hm.PlatformStand = false end
    end
end

-- FITUR AIM LOCK
local function clrAim()
    if aimBeam and aimBeam.att and aimBeam.att.Parent then aimBeam.att:Destroy() end
    aimBeam = nil
    for _,p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            for _,d in pairs(p.Character:GetDescendants()) do
                if d.Name == "AimAtt" then d:Destroy() end
            end
        end
    end
end

local function mkBeam()
    clrAim()
    local c = LP.Character
    if not c then return end
    local h = c:FindFirstChild("Head")
    if not h then return end
    local a = Instance.new("Attachment", h) a.Name = "AimAtt"
    local b = Instance.new("Beam", a) b.Attachment0 = a b.Attachment1 = a b.Width0 = 0.12 b.Width1 = 0.04 b.Color = ColorSequence.new(GOLD) b.FaceCamera = true b.Transparency = NumberSequence.new(0.3) b.Enabled = false
    aimBeam = {att = a, beam = b}
end

local function findT(mode)
    local c = LP.Character
    if not c then return nil end
    local mh = c:FindFirstChild("HumanoidRootPart")
    if not mh then return nil end
    local ls = {}
    for _,p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hm = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hm and hm.Health > 0 then
                local pt
                if mode == "head" then pt = p.Character:FindFirstChild("Head")
                else pt = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso") or hrp end
                if pt then table.insert(ls, {p = pt, d = (hrp.Position - mh.Position).Magnitude}) end
            end
        end
    end
    if #ls == 0 then return nil end
    table.sort(ls, function(a,b) return a.d < b.d end)
    return ls[1].p
end

local function stopAim()
    if aimC then aimC:Disconnect() aimC = nil end
    clrAim()
end

local function startAim(mode)
    stopAim()
    mkBeam()
    aimC = RunService.RenderStepped:Connect(function()
        if mode == "head" and not aHOn then return end
        if mode == "body" and not aBOn then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local t = findT(mode)
        if not t or not t.Parent then
            if aimBeam and aimBeam.beam then aimBeam.beam.Enabled = false end
            return
        end
        local tcf = CFrame.new(cam.CFrame.Position, t.Position)
        cam.CFrame = cam.CFrame:Lerp(tcf, 0.25)
        if aimBeam and aimBeam.beam then
            local a1 = t:FindFirstChild("AimAtt")
            if not a1 then a1 = Instance.new("Attachment", t) a1.Name = "AimAtt" end
            aimBeam.beam.Attachment1 = a1
            aimBeam.beam.Enabled = true
        end
    end)
end

-- FITUR TELEPORT
local function doTeleport()
    local c = LP.Character
    if not c then return end
    local myHrp = c:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    local list = {}
    for _,p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then table.insert(list, {hrp = hrp, dist = (hrp.Position - myHrp.Position).Magnitude, name = p.Name}) end
        end
    end
    if #list > 0 then
        table.sort(list, function(a,b) return a.dist < b.dist end)
        myHrp.CFrame = list[1].hrp.CFrame * CFrame.new(0, 0, 3)
        showNotif("Teleported ke " .. list[1].name)
    end
end

-- FITUR COPY AVA (VIRTUAL)
local function applyAvatarVirtual(uid, name)
    local c = LP.Character
    if not c then showNotif("Character gak ada") return end
    
    showNotif("Loading AVA "..name.."...")
    task.spawn(function()
        local suc, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(uid) end)
        if not suc or not desc then showNotif("Gagal ambil AVA") return end
        
        local shirt = desc.Shirt
        local pants = desc.Pants
        local bodyColors = desc.BodyColors
        local face = desc.Face
        
        local torso = c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
        local head = c:FindFirstChild("Head")
        
        if shirt and shirt ~= 0 then
            local s = c:FindFirstChildOfClass("Shirt") or Instance.new("Shirt", c)
            s.ShirtTemplate = "rbxassetid://"..shirt
        end
        
        if pants and pants ~= 0 then
            local p = c:FindFirstChildOfClass("Pants") or Instance.new("Pants", c)
            p.PantsTemplate = "rbxassetid://"..pants
        end
        
        if bodyColors then
            local bc = c:FindFirstChildOfClass("BodyColors") or Instance.new("BodyColors", c)
            pcall(function()
                bc.HeadColor = bodyColors.HeadColor
                bc.LeftArmColor = bodyColors.LeftArmColor
                bc.RightArmColor = bodyColors.RightArmColor
                bc.LeftLegColor = bodyColors.LeftLegColor
                bc.RightLegColor = bodyColors.RightLegColor
                bc.TorsoColor = bodyColors.TorsoColor
            end)
        end
        
        if face and face ~= 0 and head then
            local f = head:FindFirstChildOfClass("Decal") or Instance.new("Decal", head)
            f.Face = Enum.NormalId.Front
            f.Texture = "rbxassetid://"..face
        end
        
        showNotif("AVA "..name.." Berhasil (Virtual)!")
    end)
end

